# ── Database ────────────────────────────────────────────────────────────────
# Supabase transaction pooler (:6543) is mandatory once more than one service
# connects; prepared statements must be off on that port.
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# ── Solana (devnet only) ────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
PUMPKING_PROGRAM_ID=F2cw4FWjzUL29G4WEWHANUE2jXAyF9QJLCdvmsjy7YbY

# Aggregator: the only role allowed to write the cell day log.
# It cannot issue policies, move capital, or stop a payout.
AGGREGATOR_KEYPAIR=

# The farmer of the demo: buys the policy, pays the premium, receives the
# payout (FR-025: buyer, owner and payer are one key). Only scripts/devnet-*
# read it; neither the API nor the worker does.
POLICY_OWNER_KEYPAIR=

# Mock stablecoin used for premiums, capital, stake and payouts.
# The mint authority is deliberately NOT the pool authority: a pool that can
# print its own asset is solvent by definition, which makes the solvency
# check meaningless.
ASSET_MINT=
ASSET_MINT_AUTHORITY_KEYPAIR=

# ── Reference weather source ────────────────────────────────────────────────
# Public, no key. Used only to flag an interval as disputed; it can never
# override the sensor median or block a payout.
REFERENCE_BASE_URL=https://api.open-meteo.com/v1/forecast

# ── Runtime ─────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info

# Scenario mode compresses time: one "day" lasts SECONDS_PER_DAY seconds
# instead of 86400. Formulas, consensus and money movement are unchanged.
#
# SECONDS_PER_DAY is a field of the on-chain pool, not of these processes: the
# worker reads genesis_ts, seconds_per_day, the dry threshold and the minimum
# vote count off the Pool account every cycle, so it cannot disagree with the
# program about which day it is. The line below is what initialize_pool is
# given, never what the worker is told.
SCENARIO_MODE=off
SECONDS_PER_DAY=86400

# Origins the browser may call the API from. "*" is the default and is not a
# hole left open: every route is either a public read or authenticated by the
# sensor's own signature, and there is no cookie or session for an origin to
# borrow.
WEB_ORIGIN=*

# ── Worker ──────────────────────────────────────────────────────────────────
# Whether the aggregation loop turns inside the API process (T056).
#
# "on" is the free deployment: Render's free plan has one web service and no
# background worker, so there is nowhere else for the loop to run. It then
# shares the API's database pool and reports on the API's /health, under a
# "worker" key. "off" — the default — is the local two-process run, where the
# worker is started on its own and answers on WORKER_PORT.
#
# Never "on" in two processes at once: both would write the same day, each
# blind to the row the other had not signed yet.
RUN_WORKER=off

# Its own port; used only when the worker runs as its own process.
WORKER_PORT=8081

# How finely a day is cut. Not on chain — the program is handed a day and gets
# the count as total_intervals inside the record (FR-048).
INTERVALS_PER_DAY=24

# FR-048: hundredths of a day's intervals that must carry a value.
MINIMUM_COVERAGE_X100=75

# How often the loop turns: closeDueDays -> settleAfterDays -> closeAfterDays.
# Well under SC-001's sixty seconds, which should be spent on confirmation.
CYCLE_INTERVAL_MS=5000

# How far back a run reaches for days it never wrote.
BACKLOG_DAYS=7

# Pinged once a cycle so a free tier does not idle the API to sleep. Empty by
# default, and it points at the *other* service: a process pinging itself
# proves nothing about whether it is awake — so on the single-service
# deployment (RUN_WORKER=on) this stays empty and the pinger is a scheduled
# GitHub Action (.github/workflows/keepalive.yml), outside both.
KEEPALIVE_URL=

# How long a SIGTERM'd process gets to finish what it is doing.
SHUTDOWN_TIMEOUT_MS=15000

# ── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080

# The policy the screen opens on when no ?policy= is in the URL. A deployed
# demo points this at the policy the show is about; without either the screen
# says which address it wants rather than drawing numbers nobody bought.
VITE_POLICY_PUBKEY=

# Decimals of the pool's asset mint. Not on the wire: the mint is a pool
# parameter (FR-055) and the policy route does not read it.
VITE_ASSET_DECIMALS=6
